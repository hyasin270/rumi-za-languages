{
 "lang": "xh",
 "sentences": [
  {
   "i": 0,
   "text": "Molo titshala! Ndiyavuya ukuva kuwe.",
   "en": "Hello, teacher! I am happy to hear from you.",
   "source": "conversation"
  },
  {
   "i": 1,
   "text": "Sihambe njani isifundo sezandi namhlanje?",
   "en": "How did today's phonics lesson go?",
   "source": "conversation"
  },
  {
   "i": 2,
   "text": "Namhlanje sifundisa isandi esitsha esibhalwa ngonobumba c.",
   "en": "Today we teach a new sound, written with the letter c.",
   "source": "voice_note"
  },
  {
   "i": 3,
   "text": "Molo, enkosi ngokundivumela ukuba ndibukele abantwana befunda ngokuvakalayo.",
   "en": "Hello, thank you for letting me watch the children reading aloud.",
   "source": "debrief"
  },
  {
   "i": 4,
   "text": "Sesiphi isandi oza kusifundisa kwiveki ezayo?",
   "en": "Which sound will you teach next week?",
   "source": "conversation"
  }
 ],
