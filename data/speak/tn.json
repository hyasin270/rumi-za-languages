{
 "lang": "tn",
 "sentences": [
  {
   "i": 0,
   "text": "Dumela morutabana! Ke itumelela molaetsa wa gago.",
   "en": "Hello, teacher! I am glad to get your message.",
   "source": "conversation"
  },
  {
   "i": 1,
   "text": "Thuto ya medumo e tsamaile jang gompieno?",
   "en": "How did today's phonics lesson go?",
   "source": "conversation"
  },
  {
   "i": 2,
   "text": "Ka moso, simolola ka metsotso e le metlhano ya go boeletsa medumo: o bitse modumo, barutwana ba o boeletse, morago ba o kwale mo moweng.",
   "en": "Tomorrow, start with five minutes of sound revision: you say the sound, the learners repeat it, then they write it in the air.",
   "source": "conversation"
  },
  {
   "i": 3,
   "text": "O dira tiro e ntle thata, morutabana. Go boeletsa ka metlha go a thusa.",
   "en": "You are doing very good work, teacher. Regular revision helps.",
   "source": "conversation"
  },
  {
   "i": 4,
   "text": "O tla ruta modumo ofe mo bekeng e e tlang?",
   "en": "Which sound will you teach next week?",
   "source": "conversation"
  }
 ],
