{
 "lang": "af",
 "sentences": [
  {
   "i": 0,
   "text": "Hallo! Dis lekker om van jou te hoor.",
   "en": "Hello! It is lovely to hear from you.",
   "source": "conversation"
  },
  {
   "i": 1,
   "text": "Hoe het vandag se klankles met die leerders gegaan?",
   "en": "How did today's phonics lesson with the learners go?",
   "source": "conversation"
  },
  {
   "i": 2,
   "text": "Begin môre met vyf minute klankhersiening: jy sê die klank, die leerders sê dit na en skryf dit in die lug.",
   "en": "Tomorrow, start with five minutes of sound revision: you say the sound, the learners repeat it and write it in the air.",
   "source": "conversation"
  },
  {
   "i": 3,
   "text": "Jy doen baie goeie werk. Daaglikse herhaling help regtig.",
   "en": "You are doing very good work. Daily revision really helps.",
   "source": "conversation"
  },
  {
   "i": 4,
   "text": "Watter klank gaan jy volgende week onderrig?",
   "en": "Which sound will you teach next week?",
   "source": "conversation"
  }
 ],
