{
 "lang": "zu",
 "sentences": [
  {
   "i": 0,
   "text": "Sawubona thisha! Ngiyajabula ukuxhumana nawe.",
   "en": "Hello, teacher! I am glad to connect with you.",
   "source": "conversation"
  },
  {
   "i": 1,
   "text": "Sihambe kanjani isifundo semisindo namuhla?",
   "en": "How did today's phonics lesson go?",
   "source": "conversation"
  },
  {
   "i": 2,
   "text": "Into eyodwa okumele uyenze kahle yile: vumela abafundi bahlanganise imisindo bona ngokwabo.",
   "en": "The one thing you must get right is this: let the learners blend the sounds by themselves.",
   "source": "voice_note"
  },
  {
   "i": 3,
   "text": "Ngiyabonga kakhulu ngokungivumela ukuthi ngibe sekilasini lakho namuhla.",
   "en": "Thank you very much for letting me be in your class today.",
   "source": "debrief"
  },
  {
   "i": 4,
   "text": "Uzofundisa muphi umsindo olandelayo ngesonto elizayo?",
   "en": "Which sound will you teach next week?",
   "source": "conversation"
  }
 ],
