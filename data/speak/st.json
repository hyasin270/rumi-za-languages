{
 "lang": "st",
 "sentences": [
  {
   "i": 0,
   "text": "Dumela mosuwe! Ke thabela molaetsa wa hao.",
   "en": "Hello, teacher! I am glad to get your message.",
   "source": "conversation"
  },
  {
   "i": 1,
   "text": "Thuto ya medumo e tsamaile jwang kajeno?",
   "en": "How did today's phonics lesson go?",
   "source": "conversation"
  },
  {
   "i": 2,
   "text": "Ntho e le nngwe eo ke kopang o e etse hantle kajeno ke ena: tlohela baithuti ba tswake dinoko ka bobona.",
   "en": "The one thing I ask you to get right today is this: let the learners blend the syllables themselves.",
   "source": "voice_note"
  },
  {
   "i": 3,
   "text": "Ke ratile ha o kopa baithuti ho mamela modumo o qalang pele ba kgetha karete.",
   "en": "I liked that you asked the learners to listen for the first sound before they chose a card.",
   "source": "debrief"
  },
  {
   "i": 4,
   "text": "O tla ruta modumo ofe bekeng e tlang?",
   "en": "Which sound will you teach next week?",
   "source": "conversation"
  }
 ],
