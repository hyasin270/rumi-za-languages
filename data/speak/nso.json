{
 "lang": "nso",
 "sentences": [
  {
   "i": 0,
   "text": "Thobela morutiši! Ke thabela go kwa go wena.",
   "en": "Hello, teacher! I am happy to hear from you.",
   "source": "conversation"
  },
  {
   "i": 1,
   "text": "Thuto ya medumo e sepetše bjang lehono?",
   "en": "How did today's phonics lesson go?",
   "source": "conversation"
  },
  {
   "i": 2,
   "text": "Gosasa, thoma ka metsotso ye mehlano ya go boeletša medumo: o bitša modumo, barutwana ba o boeletša, ke moka ba o ngwala moyeng.",
   "en": "Tomorrow, start with five minutes of sound revision: you say the sound, the learners repeat it, then they write it in the air.",
   "source": "conversation"
  },
  {
   "i": 3,
   "text": "O dira mošomo wo mobotse kudu, morutiši. Go boeletša ka mehla go a thuša.",
   "en": "You are doing very good work, teacher. Regular revision helps.",
   "source": "conversation"
  },
  {
   "i": 4,
   "text": "O tla ruta modumo ofe beke ye e tlago?",
   "en": "Which sound will you teach next week?",
   "source": "conversation"
  }
 ],
